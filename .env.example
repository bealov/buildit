# Copiază acest fișier ca .env.local (exclus din Git) și completează valorile din
# Supabase → proiectul buildit-dev → Connect / Settings → API Keys.
# NU pune aici cheia secretă (sb_secret_…) și nu publica .env.local.

# Interfață: afișează conturile reale. Nu înlocuiește protecția din baza de date.
VITE_ENABLE_REAL_ACCOUNTS=true
# Adresa proiectului, de forma https://<referinta-proiectului>.supabase.co
VITE_SUPABASE_URL=
# Cheia publishable (începe cu sb_publishable_). Este publică prin natura ei; RLS protejează datele.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Doar pentru npm run test:remote (verificarea cu două conturi pe buildit-dev).
BUILDIT_TEST_TARGET=buildit-dev
BUILDIT_TEST_A_EMAIL=
BUILDIT_TEST_A_PASSWORD=
BUILDIT_TEST_B_EMAIL=
BUILDIT_TEST_B_PASSWORD=
# Opțional: 1 = testul activează permanent al doilea rol pentru contul A.
BUILDIT_TEST_ALLOW_ROLE_ACTIVATION=0
